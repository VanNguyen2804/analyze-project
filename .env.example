PORT=3000
NODE_ENV=development
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=lotterydb
PGUSER=postgres
PGPASSWORD=
AI_LAB_ENABLED=true
AI_LAB_FEEDBACK_LEARNING_RATE=0.05
AI_LAB_FEEDBACK_SELECTED_EXTRA_WEIGHT=0.25
AI_LAB_FEEDBACK_MAXIMUM_DRAWS=60
STOCKS_SOURCE_ENABLED=true
STOCKS_SOURCE_PRICE_SCALE=1000
STOCKS_SOURCE_PRICE_BASIS=UNKNOWN
STOCKS_SOURCE_VERIFIED=false
STOCKS_ML_BUY_THRESHOLD=0.60
STOCKS_ML_SELL_THRESHOLD=0.60
STOCKS_ML_ROUND_TRIP_COST=0.004
STOCKS_RECOMMENDATION_BREAKOUT_ATR=0.25
STOCKS_RECOMMENDATION_VOLUME_MULTIPLE=1.2
STOCKS_RECOMMENDATION_STOP_ATR=1.5
STOCKS_RECOMMENDATION_TARGET_ATR=3.0
STOCKS_RECOMMENDATION_MAX_BUY_RSI=70

# Disable only new shrunk-frequency / coverage captures; preserve historical evidence.
AI_LAB_CHALLENGERS_ENABLED=true
